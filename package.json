{
  "name": "qflarebot-plugin-image-info",
  "version": "0.1.0",
  "description": "QFlareBot 图片信息解析：EXIF、拍摄参数、GPS 与地址查询",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clown145/qflarebot-plugin-image-info.git"
  },
  "type": "module",
  "keywords": [
    "qflarebot-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "qqbot-plugin build",
    "sync": "npm run build && node -e \"require('node:fs').copyFileSync('dist/manifest.json','manifest.json')\"",
    "test": "vitest run",
    "test:workers": "npm run build && node scripts/smoke-workers.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exifr": "7.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@qqbot/plugin-cli": "file:../qqbot-workers/packages/plugin-cli",
    "@qqbot/sdk": "file:../qqbot-workers/packages/sdk",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
